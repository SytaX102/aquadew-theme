
{% style %}
  #AquaDewTrending-{{ section.id }} {
    --ad-green: {{ section.settings.accent_color }};
    --ad-text: #151515;
    padding: 48px 18px;
    background: {{ section.settings.background_color }};
    color: var(--ad-text);
    font-family: Arial, Helvetica, sans-serif;
  }

  #AquaDewTrending-{{ section.id }} *,
  #AquaDewTrending-{{ section.id }} *::before,
  #AquaDewTrending-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #AquaDewTrending-{{ section.id }} .ad-trending__inner {
    max-width: 1320px;
    margin: 0 auto;
  }

  #AquaDewTrending-{{ section.id }} .ad-trending__top {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 26px;
  }

  #AquaDewTrending-{{ section.id }} .ad-trending__eyebrow {
    margin: 0 0 10px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: #555555;
  }

  #AquaDewTrending-{{ section.id }} .ad-trending__heading {
    margin: 0;
    font-size: clamp(30px, 5vw, 48px);
    line-height: 1;
    font-weight: 900;
    letter-spacing: -1.8px;
    text-transform: uppercase;
  }

  #AquaDewTrending-{{ section.id }} .ad-trending__heading span {
    color: #638e25;
  }

  #AquaDewTrending-{{ section.id }} .ad-trending__intro {
    max-width: 520px;
    margin: 12px 0 0;
    color: #666666;
    font-size: 14px;
    line-height: 1.6;
  }

  #AquaDewTrending-{{ section.id }} .ad-trending__view-all {
    flex-shrink: 0;
    color: var(--ad-text);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  #AquaDewTrending-{{ section.id }} .ad-trending__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 12px;
  }

  #AquaDewTrending-{{ section.id }} .ad-product {
    min-width: 0;
  }

  #AquaDewTrending-{{ section.id }} .ad-product__image-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 10px;
    background: #eeeeea;
  }

  #AquaDewTrending-{{ section.id }} .ad-product__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  #AquaDewTrending-{{ section.id }} .ad-product__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .3s ease;
  }

  #AquaDewTrending-{{ section.id }} .ad-product__image-link:hover .ad-product__image {
    transform: scale(1.045);
  }

  #AquaDewTrending-{{ section.id }} .ad-product__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 12px;
    text-align: center;
    font-size: 13px;
    font-weight: 700;
    color: #777777;
  }

  #AquaDewTrending-{{ section.id }} .ad-product__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 1;
    padding: 7px 9px;
    border-radius: 4px;
    background: var(--ad-green);
    color: #111111;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .6px;
    text-transform: uppercase;
  }

  #AquaDewTrending-{{ section.id }} .ad-product__info {
    padding: 12px 2px 0;
  }

  #AquaDewTrending-{{ section.id }} .ad-product__title {
    margin: 0;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 700;
  }

  #AquaDewTrending-{{ section.id }} .ad-product__title a {
    color: inherit;
    text-decoration: none;
  }

  #AquaDewTrending-{{ section.id }} .ad-product__title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #AquaDewTrending-{{ section.id }} .ad-product__price {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 7px;
    font-size: 13px;
    font-weight: 800;
  }

  #AquaDewTrending-{{ section.id }} .ad-product__compare {
    color: #888888;
    font-weight: 400;
    text-decoration: line-through;
  }

  #AquaDewTrending-{{ section.id }} .ad-product__empty {
    padding: 32px 18px;
    border: 1px dashed #aaaaaa;
    border-radius: 10px;
    color: #555555;
    line-height: 1.6;
  }

  #AquaDewTrending-{{ section.id }} .ad-trending__footer {
    margin-top: 30px;
    text-align: center;
  }

  #AquaDewTrending-{{ section.id }} .ad-trending__button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 50px;
    padding: 0 25px;
    border: 2px solid #151515;
    border-radius: 6px;
    background: #151515;
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
    transition: background .2s ease, color .2s ease;
  }

  #AquaDewTrending-{{ section.id }} .ad-trending__button:hover {
    background: transparent;
    color: #151515;
  }

  @media screen and (min-width: 750px) {
    #AquaDewTrending-{{ section.id }} {
      padding: 76px 5%;
    }

    #AquaDewTrending-{{ section.id }} .ad-trending__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 30px 18px;
    }

    #AquaDewTrending-{{ section.id }} .ad-product__title {
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #AquaDewTrending-{{ section.id }} .ad-product__image,
    #AquaDewTrending-{{ section.id }} .ad-trending__button {
      transition: none;
    }
  }
{% endstyle %}

<section id="AquaDewTrending-{{ section.id }}">
  <div class="ad-trending__inner">
    <div class="ad-trending__top">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="ad-trending__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        <h2 class="ad-trending__heading">
          {{ section.settings.heading | escape }}
          <span>{{ section.settings.highlight | escape }}</span>
        </h2>

        {% if section.settings.description != blank %}
          <p class="ad-trending__intro">{{ section.settings.description | escape }}</p>
        {% endif %}
      </div>

      {% if section.settings.collection != blank and section.settings.show_view_all %}
        <a class="ad-trending__view-all" href="{{ section.settings.collection.url }}">
          View all →
        </a>
      {% endif %}
    </div>

    {% if section.settings.collection != blank and section.settings.collection.products.size > 0 %}
      <div class="ad-trending__grid">
        {% for product in section.settings.collection.products limit: section.settings.product_limit %}
          <article class="ad-product">
            <div class="ad-product__image-wrap">
              {% if section.settings.show_sale_badge and product.compare_at_price > product.price %}
                <span class="ad-product__badge">ON SALE</span>
              {% elsif forloop.index <= 2 %}
                <span class="ad-product__badge">TRENDING</span>
              {% endif %}

              <a class="ad-product__image-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                {% if product.featured_image %}
                  {{
                    product.featured_image
                    | image_url: width: 800
                    | image_tag:
                      class: 'ad-product__image',
                      widths: '240, 360, 540, 800',
                      sizes: '(min-width: 750px) 24vw, 50vw',
                      loading: 'lazy'
                  }}
                {% else %}
                  <div class="ad-product__placeholder">Product image coming soon</div>
                {% endif %}
              </a>
            </div>

            <div class="ad-product__info">
              <h3 class="ad-product__title">
                <a href="{{ product.url }}">{{ product.title | escape }}</a>
              </h3>

              <div class="ad-product__price">
                <span>{{ product.price | money }}</span>
                {% if section.settings.show_sale_badge and product.compare_at_price > product.price %}
                  <span class="ad-product__compare">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>

      {% if section.settings.show_button %}
        <div class="ad-trending__footer">
          <a class="ad-trending__button" href="{{ section.settings.collection.url }}">
            {{ section.settings.button_label | escape }}
          </a>
        </div>
      {% endif %}
    {% else %}
      <div class="ad-trending__empty">
        <strong>Your trending products will appear here.</strong>
        <p>Select a collection in this section's settings and add products to that collection in Shopify Admin.</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "AquaDew Trending",
  "tag": "section",
  "class": "aquadew-trending-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "YOUR DAILY SCROLL, UPGRADED"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "TRENDING"
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Highlighted heading",
      "default": "NOW."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "The clever finds and must-have products everyone's talking about."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Number of products",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "Show sale badge and compare-at price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View all link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show collection button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "SHOP ALL FINDS"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Badge color",
      "default": "#B7FF4A"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "AquaDew Trending"
    }
  ]
}
{% endschema %}