
{% style %}
  #AquaDewHero-{{ section.id }} {
    --ad-accent: {{ section.settings.accent_color }};
    --ad-ink: #111111;
    position: relative;
    overflow: hidden;
    padding: 42px 20px;
    background: {{ section.settings.background_color }};
    color: var(--ad-ink);
    font-family: Arial, Helvetica, sans-serif;
  }

  #AquaDewHero-{{ section.id }} *,
  #AquaDewHero-{{ section.id }} *::before,
  #AquaDewHero-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #AquaDewHero-{{ section.id }} .ad-hero__inner {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 32px;
  }

  #AquaDewHero-{{ section.id }} .ad-hero__content {
    position: relative;
    z-index: 1;
  }

  #AquaDewHero-{{ section.id }} .ad-hero__badge {
    display: inline-flex;
    padding: 9px 13px;
    border-radius: 999px;
    background: var(--ad-accent);
    color: #111111;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    margin-bottom: 22px;
  }

  #AquaDewHero-{{ section.id }} .ad-hero__title {
    max-width: 700px;
    margin: 0;
    font-size: clamp(43px, 9vw, 88px);
    line-height: .96;
    letter-spacing: -4px;
    font-weight: 900;
    text-transform: uppercase;
  }

  #AquaDewHero-{{ section.id }} .ad-hero__title em {
    color: var(--ad-accent);
    font-style: normal;
  }

  #AquaDewHero-{{ section.id }} .ad-hero__text {
    max-width: 470px;
    margin: 22px 0;
    font-size: 16px;
    line-height: 1.7;
    color: #4c4c4c;
  }

  #AquaDewHero-{{ section.id }} .ad-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 54px;
    padding: 0 24px;
    border: 2px solid #111111;
    border-radius: 7px;
    background: #111111;
    color: #ffffff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .7px;
    text-transform: uppercase;
    transition: transform .2s ease, background .2s ease;
  }

  #AquaDewHero-{{ section.id }} .ad-hero__button:hover {
    transform: translateY(-3px);
    background: #303030;
  }

  #AquaDewHero-{{ section.id }} .ad-hero__button:focus-visible {
    outline: 3px solid var(--ad-accent);
    outline-offset: 4px;
  }

  #AquaDewHero-{{ section.id }} .ad-hero__visual {
    min-height: 300px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 18px;
    background: linear-gradient(135deg, var(--ad-accent), #e9ffd8 65%, #ffffff);
  }

  #AquaDewHero-{{ section.id }} .ad-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 300px;
    max-height: 560px;
    object-fit: cover;
  }

  #AquaDewHero-{{ section.id }} .ad-hero__placeholder {
    padding: 30px;
    text-align: center;
    font-size: clamp(25px, 4vw, 42px);
    line-height: 1.1;
    font-weight: 900;
    text-transform: uppercase;
    transform: rotate(-5deg);
  }

  #AquaDewHero-{{ section.id }} .ad-hero__placeholder span {
    display: inline-block;
    padding: 10px 14px;
    background: #111111;
    color: #ffffff;
  }

  #AquaDewHero-{{ section.id }} .ad-hero__note {
    margin-top: 16px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #555555;
  }

  @media screen and (min-width: 750px) {
    #AquaDewHero-{{ section.id }} {
      padding: 76px 5%;
    }

    #AquaDewHero-{{ section.id }} .ad-hero__inner {
      grid-template-columns: 1.05fr .95fr;
      gap: 48px;
    }

    #AquaDewHero-{{ section.id }} .ad-hero__visual {
      min-height: 470px;
    }

    #AquaDewHero-{{ section.id }} .ad-hero__image {
      min-height: 470px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #AquaDewHero-{{ section.id }} .ad-hero__button {
      transition: none;
    }
  }
{% endstyle %}

<section id="AquaDewHero-{{ section.id }}" aria-labelledby="AquaDewHeroTitle-{{ section.id }}">
  <div class="ad-hero__inner">
    <div class="ad-hero__content">
      {% if section.settings.badge != blank %}
        <div class="ad-hero__badge">{{ section.settings.badge | escape }}</div>
      {% endif %}

      <h1 class="ad-hero__title" id="AquaDewHeroTitle-{{ section.id }}">
        {{ section.settings.heading | escape }}
        <em>{{ section.settings.highlight | escape }}</em>
      </h1>

      {% if section.settings.description != blank %}
        <div class="ad-hero__text">
          {{ section.settings.description | escape | newline_to_br }}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a class="ad-hero__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label | escape }}
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}

      {% if section.settings.note != blank %}
        <div class="ad-hero__note">{{ section.settings.note | escape }}</div>
      {% endif %}
    </div>

    <div class="ad-hero__visual">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            class: 'ad-hero__image',
            widths: '480, 720, 960, 1200, 1600',
            sizes: '(min-width: 750px) 48vw, 100vw',
            loading: 'eager'
        }}
      {% else %}
        <div class="ad-hero__placeholder">
          <span>Find your next<br>favorite thing.</span>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AquaDew viral hero",
  "tag": "section",
  "class": "aquadew-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Small badge",
      "default": "THE INTERNET MADE US DO IT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "YOUR NEXT"
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Colored heading",
      "default": "OBSESSION."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover clever finds, everyday essentials and trending products worth talking about."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHOP THE FINDS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small note below button",
      "default": "YOUR FEED, BUT BETTER."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#B7FF4A"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F7F7F2"
    }
  ],
  "presets": [
    {
      "name": "AquaDew viral hero"
    }
  ]
}
{% endschema %}